                <item>
                        <question type="mc">Производственная функция в общем виде, представляется как:</question>
                        <answer>К = F ( L).</answer>
                        <answer>Y = F(K)-F(L).</answer>
                        <answer>Y = F(P).</answer>
                        <answer>Y = F(K,L)-F(P).</answer>
                        <answer correct="y">Y = F(K,L).</answer>
